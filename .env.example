# Botera Shop — настройки окружения. Скопируйте в .env: cp .env.example .env
# Для docker compose хосты базы и Redis подставляются сами (db, redis) —
# значения localhost ниже нужны, только когда Django запускается без Docker.

# --- Обязательно -------------------------------------------------------------
# Ключ шифрования токенов ботов (Fernet). Сгенерировать один раз:
#   openssl rand -base64 32 | tr '+/' '-_'
# Не меняйте после того, как сохранили токены ботов: старые не расшифруются.
BOT_TOKEN_ENCRYPTION_KEY=

# --- Тестовые данные (docker compose загружает их при каждом старте) --------
# true — создать два демо-заведения (кальянная Night Owl и кафе Riverstone),
# если их ещё нет; уже созданные не трогаются, только подключаются боты.
DEMO_SEED=true
# Токены ботов из @BotFather — по одному боту на заведение (можно один).
# Имя бота узнаётся у Telegram само; без токена бот заведения выключен.
DEMO_CAFE_BOT_TOKEN=
DEMO_HOOKAH_BOT_TOKEN=
# Ваш Telegram ID (узнать: напишите @userinfobot). Вы станете владельцем обоих
# заведений: /staff в боте, уведомления о заказах, вызовах, счетах; плюс
# стартовые бонусы на ваш гостевой профиль.
DEMO_TELEGRAM_ID=
DEMO_TELEGRAM_USERNAME=
DEMO_START_BONUSES=500
# Вход в Admin (http://localhost:8000/admin/).
DEMO_ADMIN_USERNAME=platform_admin
DEMO_ADMIN_PASSWORD=botera12345
DEMO_STAFF_PASSWORD=botera12345

# --- Django ------------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIMEZONE=Europe/Kyiv
DJANGO_LANGUAGE_CODE=ru-ru
# true — SQLite вместо PostgreSQL (только без Docker, для быстрого знакомства).
DJANGO_USE_SQLITE=false
DJANGO_SQLITE_PATH=db.sqlite3

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=tableos
POSTGRES_USER=tableos
POSTGRES_PASSWORD=tableos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis и Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Порты на вашем компьютере -------------------------------------------------
# Admin открывается на 8000; поменяйте, если порт занят.
# WEB_PORT_ON_HOST=8000
# Admin доступен только с этого компьютера. Открыть для сети (например, с
# телефона по Wi-Fi) — 0.0.0.0; демо-пароль известен, в чужой сети не делайте.
# WEB_BIND_ON_HOST=127.0.0.1
# База и Redis наружу не открыты (внутри Docker они db и redis). Открыть их
# для запуска без Docker: infrastructure/docker/compose.ports.yml.
# DB_PORT_ON_HOST=5432
# REDIS_PORT_ON_HOST=6379
