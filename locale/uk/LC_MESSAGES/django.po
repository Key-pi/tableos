msgstr "відправлення"

#: apps/partners/models.py
msgid "Для {title} включите хотя бы один способ оплаты."
msgstr "Для {title} увімкніть хоча б один спосіб оплати."

#: apps/partners/models.py
msgid "Для {title} с оплатой переводом укажите реквизиты."
msgstr "Для {title} з оплатою переказом вкажіть реквізити."

