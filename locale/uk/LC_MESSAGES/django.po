msgstr "До мого столу"

#: bot/keyboards/session.py
msgid "Начать новый визит"
msgstr "Почати новий візит"

#: bot/middlewares/partner_runtime.py
msgid "Работа бота приостановлена, ожидайте обновлений."
msgstr "Роботу бота призупинено, очікуйте оновлень."

#: bot/services/content.py
msgid "В этом боте корзина сейчас недоступна для выбранного сценария заказа."
msgstr "У цьому боті кошик зараз недоступний для обраного способу замовлення."

#: bot/services/content.py
msgid "Доступные действия:"
msgstr "Доступні дії:"

#: bot/services/content.py
msgid "Откройте меню и посмотрите доступные позиции."
msgstr "Відкрийте меню й перегляньте доступні позиції."

#: bot/services/content.py
msgid "Активируйте стол по QR-коду, чтобы оформить заказ."
msgstr "Активуйте стіл за QR-кодом, щоб оформити замовлення."

#: bot/services/content.py
msgid "Для доставки нажмите «{button_delivery_label}», добавьте позиции из меню, затем в корзине «Оформить»: адрес, время, бонусы, способ оплаты."
msgstr "Для доставки натисніть «{button_delivery_label}», додайте позиції з меню, потім у кошику «Оформити»: адреса, час, бонуси, спосіб оплати."

#: bot/services/content.py
msgid "Для самовывоза нажмите «{button_pickup_label}», добавьте позиции из меню, затем в корзине «Оформить»: время, бонусы, способ оплаты."
msgstr "Для самовивозу натисніть «{button_pickup_label}», додайте позиції з меню, потім у кошику «Оформити»: час, бонуси, спосіб оплати."

#: bot/services/content.py
msgid "Для отправки почтой нажмите «{button_shipping_label}», добавьте позиции из меню, затем в корзине «Оформить»: служба, получатель и отделение, пересылка, бонусы, способ оплаты."
msgstr "Для відправлення поштою натисніть «{button_shipping_label}», додайте позиції з меню, потім у кошику «Оформити»: служба, одержувач і відділення, пересилання, бонуси, спосіб оплати."

#: bot/services/content.py
msgid "Добавьте позиции кнопками из меню."
msgstr "Додайте позиції кнопками з меню."

#: bot/services/content.py
msgid "Проверьте заказ в корзине."
msgstr "Перевірте замовлення в кошику."

#: bot/services/content.py
msgid "Нажмите «Оформить заказ»."
msgstr "Натисніть «Оформити замовлення»."

#: bot/services/content.py
msgid "После активации стола можно позвать персонал кнопкой \"{button_call_staff_label}\"."
msgstr "Після активації столу можна покликати персонал кнопкою \"{button_call_staff_label}\"."

#: bot/services/content.py
msgid "Когда будете готовы к оплате, используйте \"{button_request_bill_label}\"."
msgstr "Коли будете готові до оплати, скористайтеся \"{button_request_bill_label}\"."

#: bot/services/content.py
msgid "В этом боте сейчас доступен профиль клиента. Откройте его кнопкой «{button_my_profile}»."
msgstr "У цьому боті зараз доступний профіль клієнта. Відкрийте його кнопкою «{button_my_profile}»."

#: bot/services/content.py
msgid "Сканируйте QR-код стола, чтобы открыть сессию и оформить заказ."
msgstr "Скануйте QR-код столу, щоб відкрити сесію й оформити замовлення."

#: bot/services/content.py
msgid "Забрать заказ с собой — кнопка «{button_pickup_label}»."
msgstr "Забрати замовлення з собою — кнопка «{button_pickup_label}»."

#: bot/services/content.py
msgid "Можно открыть меню кнопкой «{button_menu_label}»."
msgstr "Меню можна відкрити кнопкою «{button_menu_label}»."

#: bot/services/content.py
msgid "Ваш стол: #{table_number}"
msgstr "Ваш стіл: #{table_number}"

#: bot/services/content.py
msgid "Стол активирован. Теперь можно открыть меню, собрать корзину и оформить заказ."
msgstr "Стіл активовано. Тепер можна відкрити меню, зібрати кошик і оформити замовлення."

#: bot/services/content.py
msgid "Стол активирован. Теперь можно открыть меню."
msgstr "Стіл активовано. Тепер можна відкрити меню."

#: bot/services/content.py
msgid "Стол активирован."
msgstr "Стіл активовано."
