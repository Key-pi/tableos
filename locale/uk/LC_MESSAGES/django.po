msgstr "Для відправлення ввімкніть хоча б один варіант оплати пересилання."

#: apps/partners/models.py
msgid "Не меньше {min_transfer_wait_minutes} минут (или 0 — не отменять): перевод может идти не сразу."
msgstr "Не менше {min_transfer_wait_minutes} хвилин (або 0 — не скасовувати): переказ може йти не одразу."

