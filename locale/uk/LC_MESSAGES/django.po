msgstr "Для гостей, чия мова Telegram не ввімкнена нижче. Має бути ввімкнена."

#: apps/partners/models.py
msgid "Язык гостей: украинский"
msgstr "Мова гостей: українська"

#: apps/partners/models.py
msgid "Язык гостей: русский"
