# Botera Shop — продакшен. Скопируйте: cp .env.production.example .env.production
# и заполните всё. Файл с настоящими значениями не коммитьте (он в .gitignore).
# Запуск: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# Подробно: docs/engineering/DEPLOYMENT.md
#
# Продакшен-настройки не стартуют со слабыми значениями: стандартным
# ключом, паролем базы tableos, без доменов в DJANGO_ALLOWED_HOSTS.

# --- Секреты (генерировать на сервере, хранить в менеджере паролей) ----------
# python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
# Ключ шифрования токенов ботов (Fernet): openssl rand -base64 32 | tr '+/' '-_'
# Не меняйте после того, как сохранили токены ботов.
BOT_TOKEN_ENCRYPTION_KEY=
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Домен ---------------------------------------------------------------------
# Домен(ы) Admin через запятую, без схемы.
DJANGO_ALLOWED_HOSTS=shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# Сколько секунд браузеры помнят «только HTTPS». Начните с 3600; когда HTTPS
# точно работает, поднимите до 31536000.
DJANGO_SECURE_HSTS_SECONDS=3600

# --- База ---------------------------------------------------------------------
POSTGRES_DB=botera_shop
POSTGRES_USER=botera

# --- Прочее -------------------------------------------------------------------
DJANGO_DEBUG=false
DJANGO_TIMEZONE=Europe/Kyiv
# Язык платформы (uk, ru, en): Admin без выбранного языка и новые боты.
DJANGO_LANGUAGE_CODE=uk
DEMO_SEED=false
# Процессов gunicorn (примерно 2 × ядер + 1).
WEB_WORKERS=3
# Процессов бота: каждый бот партнёра — ровно в одном, один процесс занимает
# одно ядро и около 250 МБ. На 2 ядрах: 1 — до ~30 партнёров в пиковый час,
# 3 — до ~50 (нужно 8 ГБ памяти); docs/engineering/LOAD_TESTING.md.
BOT_PROCESSES=2
# Процессов доставки уведомлений (каждый ~250 МБ памяти); рассылки идут
# отдельным процессом сервиса broadcasts.
WORKER_CONCURRENCY=2
# Сколько дней хранить ежедневные копии базы на сервере.
BACKUP_KEEP_DAYS=14
